NEXT_PUBLIC_SITE_URL=https://landing-sam.vercel.app/

# URL de la campagne 1 : liens « diagnostic » et « guide » des articles Ressources.
NEXT_PUBLIC_CAMPAGNE1_URL=https://landing-sam.vercel.app/
